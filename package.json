{
  "name": "erp-system",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema ERP Modular Empresarial - Arquitectura Monolito Modular",
  "scripts": {
    "dev": "pnpm --filter @erp/api run dev",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "test:unit": "pnpm --filter @erp/api run test:unit",
    "test:integration": "pnpm --filter @erp/api run test:integration",
    "lint": "pnpm -r run lint",
    "clean": "pnpm -r run clean"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": "24.x"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "eslint": "^9.0.0",
    "globals": "^16.5.0",
    "husky": "^9.1.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "uuid": "^14.0.2",
    "winston": "^3.19.0",
    "zod": "^4.6.5"
  }
}
