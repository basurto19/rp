{
  "name": "@erp/api",
  "version": "1.0.0",
  "private": true,
  "main": "dist/servers/http.js",
  "scripts": {
    "dev": "tsx watch src/servers/http.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/servers/http.js",
    "test": "jest --config ../../jest.config.js",
    "test:unit": "jest tests/unit --config ../../jest.config.js --verbose",
    "test:integration": "jest tests/integration --config ../../jest.config.js --verbose",
    "test:all": "jest --config ../../jest.config.js --verbose",
    "lint": "eslint src"
  },
  "dependencies": {
    "@erp/constants": "workspace:^",
    "@erp/shared-types": "workspace:^",
    "@erp/utils": "workspace:^",
    "@erp/validation": "workspace:^",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.4",
    "morgan": "^1.12.1",
    "uuid": "^14.0.2",
    "winston": "^3.19.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.20.4",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^11.0.0",
    "@types/winston": "^2.4.4",
    "jest": "^29.7.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.15"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@erp/shared-types$": "<rootDir>/../../packages/shared-types/src",
      "^@erp/validation$": "<rootDir>/../../packages/validation/src",
      "^@erp/constants$": "<rootDir>/../../packages/constants/src",
      "^@erp/utils$": "<rootDir>/../../packages/utils/src"
    }
  }
}
