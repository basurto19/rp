# ERP System - Base de Entorno
# Copia este archivo a .env y completa los valores.
# No guardes credenciales reales en Git.

# ================================
# ENVIRONMENT
# ================================
NODE_ENV=development
PORT=3000
API_VERSION=v1

# ================================
# SECURITY
# ================================
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_random_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# ================================
# MONGODB ATLAS
# Reemplaza <username>, <password> y cluster.mongodb.net con los datos de Atlas.
# Codifica usuario y password si contienen caracteres especiales (@, :, /, #, ?).
# ================================
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/erp-system?retryWrites=true&w=majority
MONGODB_DB_NAME=erp-system

# ================================
# CORS
# ================================
CORS_ORIGIN=http://localhost:3001

# ================================
# APP
# ================================
FRONTEND_URL=http://localhost:3001
ERP_API_BASE_URL=http://localhost:3000/api/v1
MAX_FILE_SIZE=5242880
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000

# ================================
# LOGGING
# ================================
LOG_LEVEL=dev
LOG_FORMAT=json

# ================================
# EMAIL
# ================================
RESEND_API_KEY=
EMAIL_FROM=noreply@erp-system.com

# ================================
# IA
# ================================
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=2048
